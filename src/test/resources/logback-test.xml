<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!-- Console appender with immediate flush for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{MM-dd HH:mm:ss.SSS} %-5level %logger{36}] %msg%n</pattern>
        </encoder>
        <immediateFlush>true</immediateFlush>
    </appender>

    <!-- Set default logging level to WARN -->
    <root level="WARN">
        <appender-ref ref="CONSOLE" />
    </root>

    <!-- Frontend logger (GatewayServer) -->
    <logger name="org.isarepl.IsaReplApplication" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="org.isarepl.IsaReplGatewayServer" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Backend logger (IsaREPL) - level set programmatically when debug=true -->
    <logger name="RunIsar.IsaREPL" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="RunIsar.TheoryManager" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>
    <logger name="RunIsar.TempFileManager" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
    </logger>

    <!-- Set specific package logging levels -->
    <logger name="de.unruh" level="ERROR" />
</configuration>
